{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/App.vue",
    "src/main.ts",
    "src/views/index.vue",
    "src/views/index/**/*",
    "src/components/qsd/**/*",
    "src/router/**/*",
    "src/services/qsd/**/*",
    "src/stores/index.ts",
    "src/stores/modules/qsd.ts",
    "src/styles/**/*",
    "src/assets/img/**/*",
    "src/assets/icons/**/*",
    "types/**/*.d.ts"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "types": ["google.maps"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
